# Database Configuration
# For local development: postgresql://threaded:pass@localhost:5432/threaded
# For production: use Render/Vercel managed database
DATABASE_URL="postgresql://user:pass@localhost:5432/threaded"

# JWT Authentication
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="your-secret-key-here-min-32-chars"

# AWS S3 Configuration (for image uploads)
# Create an IAM user with S3 access policy
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="us-west-1"
AWS_BUCKET_NAME="threaded-uploads"

# Frontend CORS Configuration
# Update for production domain
FRONTEND_URL="http://localhost:5173"

# Server Configuration
# Default port for local development
PORT=3000

# Environment (development, test, production)
NODE_ENV="development"